---
import { profesor } from '@/data/cursos'
---

<section class="bg-gradient-to-br from-primary-600 to-primary-800 dark:from-primary-700 dark:to-primary-900 text-white py-20 transition-colors">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">
      Clases Particulares de Refuerzo
    </h1>
    <p class="text-xl text-primary-100 dark:text-primary-200 mb-2">
      {profesor.titulo}
    </p>
    <p class="inline-block bg-primary-500/30 text-primary-100 px-4 py-1 rounded-full text-sm font-medium mb-8">
      {profesor.modalidad}
    </p>
    <div class="flex gap-4 justify-center">
      <a
        href="#niveles"
        class="bg-white text-primary-700 px-6 py-3 rounded-lg font-semibold hover:bg-primary-50 transition-colors"
      >
        Ver niveles
      </a>
      <a
        href="/contacto"
        class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors"
      >
        Contactar
      </a>
    </div>
  </div>
</section>
