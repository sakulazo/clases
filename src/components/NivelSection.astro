---
import type { Nivel } from '@/data/cursos'
import AsignaturaCard from '@/components/AsignaturaCard.astro'

export interface Props {
  nivel: Nivel
}

const { nivel } = Astro.props
---

<section id={`nivel-${nivel.id}`} class="scroll-mt-24">
  <div class="mb-6 flex items-stretch gap-3">
    <span class="w-1.5 rounded-full bg-primary-600 dark:bg-primary-400" aria-hidden="true"></span>
    <div>
      <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{nivel.label}</h3>
      <p class="text-gray-600 dark:text-gray-400">{nivel.descripcion}</p>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {nivel.asignaturas.map((asignatura) => <AsignaturaCard asignatura={asignatura} />)}
  </div>
</section>
