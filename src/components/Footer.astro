---
import { profesor } from '@/data/cursos'
---

<footer class="bg-gray-800 dark:bg-gray-950 text-gray-300 dark:text-gray-400 mt-auto transition-colors">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h4 class="text-white dark:text-gray-100 font-semibold mb-3">Clases Particulares</h4>
      <p class="text-sm leading-relaxed">
        Refuerzo escolar para ESO, Bachillerato y CFGS.
      </p>
      <p class="text-sm leading-relaxed mt-2">
        Especialidad en matemáticas, física y química.
      </p>
    </div>
    <div>
      <h4 class="text-white dark:text-gray-100 font-semibold mb-3">Contacto</h4>
      <p class="text-sm leading-relaxed">{profesor.titulo}</p>
      <p class="text-sm leading-relaxed mt-2">Clases individuales a domicilio en El Ejido (Almería)</p>
    </div>
    <div>
      <h4 class="text-white dark:text-gray-100 font-semibold mb-3">Horarios</h4>
      <p class="text-sm leading-relaxed">Clases en horario flexible</p>
      <p class="text-sm leading-relaxed mt-2">Consulta disponibilidad</p>
    </div>
  </div>
  <div class="border-t border-gray-700 dark:border-gray-800 text-center text-sm py-4">
    Clases Particulares El Ejido
  </div>
</footer>
