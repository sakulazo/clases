---
import type { Asignatura } from '@/data/cursos'
import Icon from '@/components/Icon.astro'

export interface Props {
  asignatura: Asignatura
}

const { asignatura } = Astro.props
---

<article class="w-[70%] mx-auto sm:w-full bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all p-5">
  <div class="flex items-center gap-3 mb-3">
    <div class="shrink-0 w-11 h-11 flex items-center justify-center rounded-lg bg-primary-50 dark:bg-primary-900/40">
      <Icon name={asignatura.icono} class="h-6 w-6 text-primary-600 dark:text-primary-400" />
    </div>
    <h4 class="font-semibold text-gray-900 dark:text-gray-100">{asignatura.nombre}</h4>
  </div>
  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{asignatura.descripcion}</p>
</article>
