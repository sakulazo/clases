---
import type { Asignatura } from '@/data/cursos'
import Icon from '@/components/Icon.astro'

export interface Props {
  asignatura: Asignatura
}

const { asignatura } = Astro.props
---

<article class="w-[70%] mx-auto sm:w-full bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all p-5 text-center">
  <div class="w-11 h-11 mx-auto flex items-center justify-center rounded-lg bg-primary-50 dark:bg-primary-900/40 mb-4">
    <Icon name={asignatura.icono} class="h-6 w-6 text-primary-600 dark:text-primary-400" />
  </div>
  <h4 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{asignatura.nombre}</h4>
  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{asignatura.descripcion}</p>
</article>
