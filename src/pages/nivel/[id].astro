---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { niveles } from '@/data/cursos'

export function getStaticPaths() {
  return niveles.map((nivel) => ({
    params: { id: nivel.id },
    props: { nivel }
  }))
}

const { nivel } = Astro.props
---

<BaseLayout title={nivel.label} description={nivel.descripcion}>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-4xl font-bold mb-2 dark:text-gray-100">{nivel.label}</h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg mb-8">{nivel.descripcion}</p>

      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-900/30 p-6 mb-8 transition-colors">
        <h2 class="text-xl font-bold mb-4 dark:text-gray-100">Asignaturas</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {nivel.asignaturas.map((a) => (
            <div class="flex items-start gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-700/50 transition-colors">
              <span class="text-2xl">{a.icono}</span>
              <div>
                <h3 class="font-semibold dark:text-gray-100">{a.nombre}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{a.descripcion}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
