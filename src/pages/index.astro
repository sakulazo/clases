---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import CourseCard from '@/components/CourseCard.astro'
import { niveles, especialidades } from '@/data/cursos'
---

<BaseLayout title="Inicio" description="Clases particulares de refuerzo escolar especializadas en matemáticas, física y química">
  <Hero />

  <!-- Stats -->
  <section class="bg-primary-600 dark:bg-primary-800 py-8 transition-colors">
    <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-center gap-8 sm:gap-16">
      <div class="text-center">
        <p class="text-3xl sm:text-4xl font-bold text-white">+10 años</p>
        <p class="text-primary-100 text-sm">experiencia</p>
      </div>
      <div class="hidden sm:block w-px h-12 bg-primary-400"></div>
      <div class="text-center">
        <p class="text-3xl sm:text-4xl font-bold text-white">&gt;95%</p>
        <p class="text-primary-100 text-sm">índice de aprobados</p>
      </div>
    </div>
  </section>

  <section id="niveles" class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-2 dark:text-gray-100">Niveles Educativos</h2>
      <p class="text-gray-600 dark:text-gray-400 text-center mb-10 max-w-xl mx-auto">
        Elige el nivel que necesites y te ayudaré a alcanzar tus objetivos
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {niveles.map((nivel) => <CourseCard nivel={nivel} />)}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white dark:bg-gray-900 transition-colors">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-2 dark:text-gray-100">Especialidades</h2>
      <p class="text-gray-600 dark:text-gray-400 text-center mb-10 max-w-xl mx-auto">
        Más de 10 años de experiencia en ciencias
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {especialidades.map((esp) => (
          <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 transition-colors">
            <div class="text-5xl mb-3">{esp.icono}</div>
            <h3 class="text-xl font-bold mb-2 dark:text-gray-100">{esp.nombre}</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm">{esp.descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
