---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Hero from '@/components/Hero.astro'
import NivelSection from '@/components/NivelSection.astro'
import Icon from '@/components/Icon.astro'
import { niveles, especialidades } from '@/data/cursos'

const telefono = '637449097'
const telefonoLink = `https://wa.me/${telefono}`
---

<BaseLayout
  title="Clases Particulares de Refuerzo"
  description="Clases particulares de refuerzo escolar especializadas en matemáticas, física y química en El Ejido (Almería)"
>
  <Hero />

  <!-- Niveles educativos -->
  <section id="niveles" class="py-16 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-2 dark:text-gray-100">Niveles Educativos</h2>
      <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-xl mx-auto">
        Elige el nivel que necesites y te ayudaré a alcanzar tus objetivos
      </p>
      <div class="space-y-14">
        {niveles.map((nivel) => <NivelSection nivel={nivel} />)}
      </div>
    </div>
  </section>

  <!-- Especialidades -->
  <section id="especialidades" class="py-16 bg-white dark:bg-gray-900 transition-colors scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-2 dark:text-gray-100">Especialidades</h2>
      <p class="text-gray-600 dark:text-gray-400 text-center mb-10 max-w-xl mx-auto">
        Más de 10 años de experiencia en ciencias
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          especialidades.map((esp) => (
            <div class="text-center p-6 rounded-xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 transition-colors">
              <Icon name={esp.icono} class="mx-auto mb-3 h-12 w-12 text-primary-600 dark:text-primary-400" />
              <h3 class="text-xl font-bold mb-2 dark:text-gray-100">{esp.nombre}</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">{esp.descripcion}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="py-16 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-2 dark:text-gray-100">Contacto</h2>
      <p class="text-gray-600 dark:text-gray-400 mb-10 max-w-xl mx-auto">
        Escríbeme directamente por WhatsApp y te responderé lo antes posible
      </p>

      <div class="max-w-md mx-auto bg-white dark:bg-gray-800 rounded-xl shadow-md dark:shadow-gray-900/30 p-8 transition-colors">
        <Icon name="message-circle" class="mx-auto mb-4 h-14 w-14 text-primary-600 dark:text-primary-400" />
        <a
          href={telefonoLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-green-500 dark:bg-green-600 text-white px-8 py-4 rounded-xl text-lg font-semibold hover:bg-green-600 dark:hover:bg-green-500 transition-colors shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Enviar WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
